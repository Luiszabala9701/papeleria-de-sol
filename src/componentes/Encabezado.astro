---
import type { ConfiguracionSitio } from '../tipos/contenidos';
import { obtenerTextoPublico } from '../servicios/textos-publicos';

interface Props {
  configuracion?: ConfiguracionSitio;
  rutaActual?: string;
}

const { configuracion, rutaActual = '/' } = Astro.props;

const enlaces = [
  { href: '/', texto: obtenerTextoPublico(configuracion, 'navegacion_inicio') },
  { href: '/stickers', texto: obtenerTextoPublico(configuracion, 'navegacion_catalogo') },
  { href: '/plantillas', texto: obtenerTextoPublico(configuracion, 'navegacion_plantillas') },
  { href: '/productos-fisicos', texto: obtenerTextoPublico(configuracion, 'navegacion_productos_fisicos') },
  { href: '/ayuda', texto: obtenerTextoPublico(configuracion, 'navegacion_ayuda') },
];

const enlaceActivo = (href: string) =>
  href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
---

<header class="encabezado-sitio">
  {configuracion?.mostrar_aviso_superior !== false && (
    <div class="anuncio-superior">
      <p>{configuracion?.aviso_superior || 'Pedidos personalizados en CABA y GBA · Consultanos por WhatsApp'}</p>
    </div>
  )}
  <nav class="navegacion-principal" aria-label="Navegación principal">
    <a class="marca" href="/" aria-label="Papelería de Sol, ir al inicio">
      <span class="logo-papeleria">
        <img src="/marca/logo-papeleria-de-sol-transparente.png" alt="Papelería de Sol" width="1774" height="887" />
      </span>
    </a>

    <button
      id="boton-menu"
      class="boton-menu"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="solo-lectores">Abrir menú</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <ul id="menu-principal" class="menu-principal">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class:list={{ activo: enlaceActivo(enlace.href) }}
              aria-current={enlaceActivo(enlace.href) ? 'page' : undefined}
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>

    <button id="boton-carrito" class="boton-carrito" type="button" aria-controls="panel-carrito">
      <span aria-hidden="true">♡</span>
      <span class="texto-carrito">{obtenerTextoPublico(configuracion, 'carrito_boton')}</span>
      <span id="contador-carrito" class="contador-carrito">0</span>
    </button>
  </nav>
</header>
