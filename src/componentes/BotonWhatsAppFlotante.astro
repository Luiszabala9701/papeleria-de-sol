---
const { configuracion } = Astro.props;
const numero = configuracion?.whatsapp || '541164879422';
const mensaje = encodeURIComponent('¡Hola! Quisiera consultar por los productos de Papelería de Sol.');
---

<a
  class="boton-whatsapp-flotante"
  href={`https://wa.me/${numero}?text=${mensaje}`}
  target="_blank"
  rel="noreferrer"
  aria-label="Consultar por WhatsApp"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M27.2 4.7A15.3 15.3 0 0 0 3.4 23l-1.7 6.2 6.4-1.7A15.3 15.3 0 1 0 27.2 4.7Zm-11.1 24a12.7 12.7 0 0 1-6.4-1.7l-.5-.3-3.8 1 1-3.7-.3-.6A12.7 12.7 0 1 1 16.1 28.7Zm7-9.5c-.4-.2-2.2-1.1-2.6-1.2-.3-.1-.6-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.3-.8.1a10.3 10.3 0 0 1-3-1.9 11.2 11.2 0 0 1-2.1-2.7c-.2-.4 0-.6.1-.8l.6-.7c.2-.2.2-.4.3-.6.1-.2 0-.5 0-.7l-1.2-2.8c-.3-.8-.7-.7-.9-.7h-.8c-.3 0-.7.1-1 .5-.4.4-1.3 1.2-1.3 3s1.3 3.5 1.5 3.8c.2.2 2.5 3.8 6.1 5.4.8.4 1.5.6 2 .8.9.3 1.7.3 2.4.2.7-.1 2.2-.9 2.5-1.7.3-.8.3-1.5.2-1.7-.1-.2-.3-.3-.6-.5Z" />
  </svg>
  <span>WhatsApp</span>
</a>
