---
import TarjetaProducto from './TarjetaProducto.astro';
import type { ConfiguracionSitio, Producto, TipoProducto } from '../tipos/contenidos';
import { obtenerTextoPublico } from '../servicios/textos-publicos';
import { crearUrlCatalogo, tituloPaginaCatalogo } from '../servicios/catalogo.js';
import { crearUrlAbsoluta, escaparJsonLd } from '../servicios/seo';

interface Props {
  estado: {
    buscar: string;
    categoria: string;
    pagina: number;
    totalPaginas: number;
    totalProductos: number;
    visibles: Producto[];
    tieneFiltros: boolean;
  };
  categorias: { id: string; nombre: string; tipo_producto?: TipoProducto }[];
  configuracion: ConfiguracionSitio;
  tipo: TipoProducto;
  etiquetaAria: string;
}

const { estado, categorias, configuracion, tipo, etiquetaAria } = Astro.props;
const ruta = Astro.url.pathname;
const enlacePagina = (pagina: number) => crearUrlCatalogo(ruta, { ...estado, pagina });
const categoriasDelTipo = categorias.filter((categoria) => categoria.tipo_producto === tipo);
const nombreTipo = tipo === 'fisico'
  ? 'productos físicos'
  : tipo === 'plantilla'
    ? 'plantillas'
    : 'stickers';
const datosColeccion = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: tituloPaginaCatalogo(tipo, estado.pagina),
  url: crearUrlAbsoluta(enlacePagina(estado.pagina)),
  isPartOf: { '@id': `${crearUrlAbsoluta('/')}#sitio-web` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: estado.visibles.map((producto, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: producto.nombre,
      url: crearUrlAbsoluta(`/productos/${producto.slug}`),
    })),
  },
};
---

<section id="catalogo-resultados" class="contenedor seccion-catalogo" data-tipo-listado={tipo}>
  <div class="barra-catalogo" aria-label={etiquetaAria}>
    <form id="formulario-busqueda-catalogo" class="busqueda-catalogo" role="search" method="get" action={ruta}>
      <label class="solo-lectores" for="buscador-catalogo">Buscar {nombreTipo}</label>
      <input
        id="buscador-catalogo"
        class="campo"
        type="search"
        name="buscar"
        value={estado.buscar}
        placeholder={obtenerTextoPublico(configuracion, 'catalogo_busqueda_placeholder')}
        autocomplete="off"
      />
      <button class="boton-busqueda-catalogo" type="submit" aria-label={`Buscar ${nombreTipo}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="6"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="solo-lectores">Buscar</span>
      </button>
    </form>
    <label>
      <span class="solo-lectores">Categoría de {nombreTipo}</span>
      <select id="filtro-categoria" class="selector" name="categoria" form="formulario-busqueda-catalogo">
        <option value="">{obtenerTextoPublico(configuracion, 'catalogo_todas_categorias')}</option>
        {estado.categoria && !categoriasDelTipo.some((categoria) => categoria.id === estado.categoria) && <option value={estado.categoria} selected>Categoría no disponible</option>}
        {categoriasDelTipo.map((categoria) => <option value={categoria.id} selected={categoria.id === estado.categoria}>{categoria.nombre}</option>)}
      </select>
    </label>
  </div>

  <div class="resultado-catalogo">
    <span id="informacion-resultados">{estado.totalProductos} productos</span>
    <span>{obtenerTextoPublico(configuracion, 'catalogo_aviso_disponibilidad')}</span>
  </div>

  <h2 id="titulo-resultados-catalogo" class="solo-lectores">Resultados de {nombreTipo}</h2>
  <div id="galeria-catalogo" class="cuadricula-productos" aria-labelledby="titulo-resultados-catalogo">
    {estado.visibles.map((producto, indice) => (
      <TarjetaProducto producto={producto} configuracion={configuracion} prioritaria={indice === 0} />
    ))}
    {estado.totalProductos === 0 && <p class="estado-vacio">No encontramos productos con esos filtros.</p>}
  </div>

  <nav class="paginacion" aria-label={`Paginación de ${nombreTipo}`}>
    <a id="pagina-anterior" class="boton-paginacion" href={estado.pagina > 1 ? enlacePagina(estado.pagina - 1) : undefined} aria-disabled={estado.pagina <= 1 ? 'true' : undefined} tabindex={estado.pagina <= 1 ? -1 : undefined} data-astro-prefetch="hover">{obtenerTextoPublico(configuracion, 'catalogo_pagina_anterior')}</a>
    <span id="informacion-pagina-catalogo">Página {estado.pagina} de {estado.totalPaginas}</span>
    <a id="pagina-siguiente" class="boton-paginacion" href={estado.pagina < estado.totalPaginas ? enlacePagina(estado.pagina + 1) : undefined} aria-disabled={estado.pagina >= estado.totalPaginas ? 'true' : undefined} tabindex={estado.pagina >= estado.totalPaginas ? -1 : undefined} data-astro-prefetch="hover">{obtenerTextoPublico(configuracion, 'catalogo_pagina_siguiente')}</a>
  </nav>
</section>

<script is:inline id="datos-coleccion" type="application/ld+json" set:html={escaparJsonLd(datosColeccion)}></script>
<script>
  import '../scripts/catalogo.js';
</script>

<style>
  .seccion-catalogo {
    padding-bottom: 5rem;
  }
</style>
