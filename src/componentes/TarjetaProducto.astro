---
import type { Producto } from '../tipos/contenidos';
import type { ConfiguracionSitio } from '../tipos/contenidos';
import { obtenerTextoPublico } from '../servicios/textos-publicos';
import { crearLineaSeleccion, necesitaElegirVariante, productoSinStock } from '../servicios/variantes.js';

interface Props {
  producto: Producto;
  compacta?: boolean;
  sinMarcaAgua?: boolean;
  configuracion?: ConfiguracionSitio;
}

const { producto, compacta = false, sinMarcaAgua = false, configuracion } = Astro.props;
const imagen = producto.imagenes?.find((elemento) => elemento.es_principal) || producto.imagenes?.[0];
const esSticker = producto.tipo_producto === 'sticker';
const precio = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: producto.moneda || 'ARS',
  minimumFractionDigits: 0, maximumFractionDigits: 2,
}).format(producto.precio);
const sinStock = productoSinStock(producto);
const elegir = necesitaElegirVariante(producto);
---

<article class:list={['tarjeta-producto', { compacta }]} data-tipo={producto.tipo_producto}>
  <a
    class="imagen-producto"
    href={`/productos/${producto.slug}`}
    tabindex="-1"
    aria-hidden="true"
    data-proteccion-imagen={esSticker ? 'sticker' : undefined}
    data-sin-marca-agua={esSticker && sinMarcaAgua ? '' : undefined}
  >
    <img
      src={imagen?.url_publica || '/stickers/1.webp'}
      alt={imagen?.texto_alternativo || producto.nombre}
      width="709"
      height="709"
      loading="lazy"
      decoding="async"
      draggable={esSticker ? 'false' : undefined}
    />
    {producto.destacado && <span class="distintivo-producto">{obtenerTextoPublico(configuracion, 'producto_destacado')}</span>}
  </a>
  <div class="contenido-producto">
    <p class="tipo-producto">{producto.tipo_producto === 'fisico' ? obtenerTextoPublico(configuracion, 'producto_tipo_fisico') : producto.tipo_producto}</p>
    <h3><a href={`/productos/${producto.slug}`}>{producto.nombre}</a></h3>
    {!compacta && <p class="descripcion-producto">{producto.descripcion}</p>}
    <div class="pie-producto">
      <strong class="precio-producto">{elegir ? 'Desde ' : ''}{precio}</strong>
      {elegir ? <a class="boton-agregar-producto" href={`/productos/${producto.slug}`}>Elegir versión</a> : (
      <button
        class="boton-agregar-producto"
        type="button"
        data-agregar-producto
        data-producto={JSON.stringify(crearLineaSeleccion(producto))}
        aria-label={`${obtenerTextoPublico(configuracion, 'producto_agregar')} ${producto.nombre} a mi selección`}
        disabled={sinStock}
      >
        {sinStock ? 'Sin stock' : obtenerTextoPublico(configuracion, 'producto_agregar')}
      </button>)}
    </div>
  </div>
</article>
