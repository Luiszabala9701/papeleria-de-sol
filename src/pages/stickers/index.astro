---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import ListadoProductosFiltrable from '../../componentes/ListadoProductosFiltrable.astro';
import GuiaColeccion from '../../componentes/GuiaColeccion.astro';
import { crearUrlCatalogo, obtenerPaginaCatalogo, tituloPaginaCatalogo } from '../../servicios/catalogo.js';
import type { ConfiguracionSitio, Producto, TipoProducto } from '../../tipos/contenidos';
import {
  obtenerCategoriasPublicadas,
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

const [configuracion, productos, categorias] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductosPublicados({ tipo: 'sticker' }),
  obtenerCategoriasPublicadas(),
]) as [ConfiguracionSitio, Producto[], { id: string; nombre: string; tipo_producto?: TipoProducto }[]];
const paginaCatalogo = obtenerPaginaCatalogo(productos, Astro.url.searchParams);
---

<DisenoPrincipal
  titulo={tituloPaginaCatalogo('sticker', paginaCatalogo.pagina)}
  descripcion={`Stickers y calcomanías de Papelería de Sol para cuadernos, agendas y notebooks. Pedidos en CABA y GBA por WhatsApp.${paginaCatalogo.pagina > 1 ? ` Página ${paginaCatalogo.pagina}.` : ''}`}
  rutaCanonica={crearUrlCatalogo(Astro.url.pathname, paginaCatalogo)}
  noIndexar={paginaCatalogo.tieneFiltros}
  configuracion={configuracion}
  imagenSocialAlt="Stickers de Papelería de Sol"
  palabrasClave="stickers, calcomanías, pegatinas, stickers para cuadernos, stickers para agendas, stickers para notebooks, stickers Buenos Aires, Papelería de Sol"
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'catalogo_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'catalogo_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'catalogo_descripcion')}</p>
  </header>

  <ListadoProductosFiltrable
    productos={productos}
    categorias={categorias}
    configuracion={configuracion}
    tipo="sticker"
    etiquetaAria="Filtros de stickers"
  />
  {paginaCatalogo.pagina === 1 && !paginaCatalogo.tieneFiltros && <GuiaColeccion tipo="sticker" />}
</DisenoPrincipal>
