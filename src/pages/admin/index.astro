  <dialog id="dialogo-cupon" class="dialogo-recurso dialogo-comercial" aria-labelledby="titulo-dialogo-cupon">
    <form class="formulario-dialogo" data-formulario-cupon>
      <div class="cabecera-dialogo">
        <div><p class="etiqueta">Promoción</p><h2 id="titulo-dialogo-cupon">Nuevo cupón</h2></div>
        <button class="boton-icono" type="button" data-cerrar-cupon aria-label="Cerrar">×</button>
      </div>
      <input type="hidden" name="id" />
      <div class="formulario-admin formulario-dos-columnas">
        <label class="grupo-campo"><span>Código</span><input class="campo" name="codigo" maxlength="40" pattern="[A-Za-z0-9_-]{3,40}" required /></label>
        <label class="grupo-campo"><span>Aplica a</span><select class="selector" name="aplica_tipo_pedido"><option value="automatico">Pedidos automáticos</option><option value="coordinado">Pedidos coordinados</option><option value="ambos">Ambos</option></select></label>
        <label class="grupo-campo"><span>Tipo de descuento</span><select class="selector" name="tipo_descuento"><option value="porcentaje">Porcentaje</option><option value="fijo">Importe fijo</option></select></label>
        <label class="grupo-campo" data-campo-porcentaje><span>Porcentaje</span><input class="campo" name="porcentaje" type="number" min="0.01" max="100" step="0.01" /></label>
        <label class="grupo-campo" data-campo-importe hidden><span>Importe en pesos</span><input class="campo" name="importe_fijo" type="number" min="0.01" step="0.01" /></label>
        <label class="grupo-campo"><span>Compra mínima en pesos</span><input class="campo" name="compra_minima" type="number" min="0" step="0.01" value="0" /></label>
        <label class="grupo-campo"><span>Tope de descuento en pesos</span><input class="campo" name="descuento_maximo" type="number" min="0" step="0.01" /></label>
        <label class="grupo-campo"><span>Límite total de usos</span><input class="campo" name="limite_usos_total" type="number" min="1" step="1" /></label>
        <label class="grupo-campo"><span>Límite por comprador</span><input class="campo" name="limite_usos_comprador" type="number" min="1" step="1" /></label>
        <label class="grupo-campo"><span>Inicio</span><input class="campo" name="inicia_en" type="datetime-local" /></label>
        <label class="grupo-campo"><span>Vencimiento</span><input class="campo" name="vence_en" type="datetime-local" /></label>
        <label class="grupo-campo"><span>Alcance</span><select class="selector" name="alcance"><option value="todos">Todos los productos</option><option value="categorias">Categorías seleccionadas</option><option value="productos">Productos seleccionados</option></select></label>
        <label class="grupo-checkbox"><input name="activo" type="checkbox" checked /><span>Cupón activo</span></label>
        <label class="grupo-campo campo-completo"><span>Nota interna</span><textarea class="area-texto" name="descripcion_interna" maxlength="500" rows="2"></textarea></label>
        <label class="grupo-campo campo-completo" data-campo-categorias hidden><span>Categorías</span><select class="selector selector-multiple" name="categorias" multiple size="6"></select></label>
        <label class="grupo-campo campo-completo" data-campo-productos hidden><span>Productos incluidos</span><select class="selector selector-multiple" name="productos" multiple size="8"></select></label>
        <label class="grupo-campo campo-completo"><span>Productos excluidos (opcional)</span><select class="selector selector-multiple" name="excluidos" multiple size="6"></select></label>
      </div>
      <p class="mensaje-error" data-error-cupon role="alert" hidden></p>
      <div class="acciones-dialogo"><button class="boton boton-secundario" type="button" data-cerrar-cupon>Cancelar</button><button class="boton boton-principal" type="submit">Guardar cupón</button></div>
    </form>
  </dialog>

