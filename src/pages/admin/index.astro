---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import '../../estilos/administracion.css';

const configuracionDisponible = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_CLAVE_PUBLICA,
);
---

<DisenoPrincipal
  titulo="Administración | Papelería de Sol"
  descripcion="Panel privado de administración de Papelería de Sol."
  ocultarNavegacion
  noIndexar
>
  <div class="admin-aplicacion" data-configuracion-disponible={String(configuracionDisponible)}>
    <header class="admin-cabecera">
      <a class="marca" href="/" aria-label="Volver a Papelería de Sol">
        <span class="marca-sol" aria-hidden="true"></span>
        <span>
          <strong>Papelería de Sol</strong>
          <small>administración</small>
        </span>
      </a>
      <div id="datos-sesion" class="datos-sesion" hidden>
        <button id="cerrar-sesion-admin" class="boton boton-secundario" type="button">Cerrar sesión</button>
      </div>
    </header>

    {!configuracionDisponible && (
      <div id="aviso-configuracion" class="aviso-configuracion">
        <strong>Supabase todavía no está conectado.</strong>
        <p>La tienda pública funciona con datos de demostración. Para habilitar el login y guardar cambios, completá las variables indicadas en <code>.env.ejemplo</code>.</p>
      </div>
    )}

    <section id="pantalla-login" class="pantalla-login">
      <form id="formulario-login" class="tarjeta-login">
        <p class="etiqueta">Acceso privado</p>
        <h1>Administración</h1>
        <p>Ingresá con la cuenta autorizada para administrar los contenidos de la tienda.</p>

        <label class="grupo-campo">
          <span>Correo electrónico</span>
          <input id="correo-admin" class="campo" name="correo" type="email" autocomplete="username" required />
        </label>
        <label class="grupo-campo">
          <span>Contraseña</span>
          <span class="campo-con-accion">
            <input id="contrasena-admin" class="campo" name="contrasena" type="password" autocomplete="current-password" required />
            <button id="alternar-contrasena-admin" class="boton-alternar-contrasena" type="button" aria-pressed="false">Mostrar</button>
          </span>
        </label>
        <p id="error-login" class="mensaje-error" role="alert" hidden></p>
        <button class="boton boton-principal boton-ancho" type="submit" disabled={!configuracionDisponible}>Iniciar sesión</button>
        <a class="volver-tienda" href="/">← Volver a la tienda</a>
      </form>
    </section>

    <div id="panel-administracion" class="panel-administracion" hidden>
      <aside class="admin-lateral">
        <p class="admin-lateral-titulo">Contenido</p>
        <nav aria-label="Secciones de administración">
          <button class="enlace-admin activo" type="button" data-seccion-admin="resumen">Resumen</button>
          <button class="enlace-admin" type="button" data-seccion-admin="productos">Productos</button>
          <button class="enlace-admin" type="button" data-seccion-admin="categorias">Categorías</button>
          <button class="enlace-admin" type="button" data-seccion-admin="secciones">Contenido del sitio</button>
        </nav>
        <a class="enlace-ver-tienda" href="/" target="_blank">Ver tienda ↗</a>
      </aside>

      <main class="admin-contenido">
        <section class="seccion-admin activa" data-panel-admin="resumen">
          <header class="cabecera-admin">
            <div>
              <p class="etiqueta">Vista general</p>
              <h1>Resumen</h1>
              <p>Estado actual de los contenidos administrables.</p>
            </div>
          </header>
          <div id="tarjetas-resumen" class="tarjetas-resumen" aria-live="polite"></div>
          <div class="tarjeta-ayuda">
            <h2>Primeros pasos</h2>
            <ol>
              <li>Creá categorías según el tipo de producto, por ejemplo Fútbol para stickers.</li>
              <li>Agregá productos físicos, plantillas o nuevos stickers.</li>
              <li>Subí una imagen optimizada y completá la información para SEO.</li>
              <li>Publicá el producto cuando esté listo para aparecer en la tienda.</li>
            </ol>
          </div>
        </section>

        {['productos', 'categorias', 'secciones'].map((recurso) => (
          <section class="seccion-admin" data-panel-admin={recurso}>
            <header class="cabecera-admin">
              <div>
                <p class="etiqueta">Gestión de contenidos</p>
                <h1>{recurso === 'secciones' ? 'Contenido del sitio' : recurso[0].toUpperCase() + recurso.slice(1)}</h1>
                <p data-descripcion-recurso></p>
              </div>
              <button class="boton boton-principal" type="button" data-nuevo-recurso={recurso}>Crear nuevo</button>
            </header>
            <div class="barra-listado">
              <input class="campo" type="search" placeholder="Buscar…" data-buscar-recurso={recurso} />
              {recurso === 'productos' && (
                <label class="filtro-archivados">
                  <span>Mostrar</span>
                  <select class="selector" data-filtro-archivados>
                    <option value="activos">No archivados</option>
                    <option value="archivados">Solo archivados</option>
                    <option value="todos">Todos</option>
                  </select>
                </label>
              )}
              <span data-total-recurso={recurso}>Cargando…</span>
            </div>
            <div class="tabla-contenedor">
              <table class="tabla-admin">
                <thead data-cabecera-tabla={recurso}></thead>
                <tbody data-lista-recurso={recurso}></tbody>
              </table>
            </div>
            {recurso === 'secciones' && (
              <div class="contenidos-globales">
                <section class="tarjeta-contenido-global">
                  <p class="etiqueta">Marca, cabecera y pie</p>
                  <h2>Contacto y textos generales</h2>
                  <p>Estos datos se muestran en la cabecera, el footer y los enlaces de contacto de la tienda.</p>
                  <form id="formulario-configuraciones" class="formulario-dos-columnas">
                    <label class="grupo-campo"><span>Nombre de la marca</span><input class="campo" name="nombre_marca" required /></label>
                    <label class="grupo-campo"><span>Lema debajo del logo</span><input class="campo" name="lema_marca" /></label>
                    <label class="grupo-campo campo-completo"><span>Mensaje superior</span><input class="campo" name="aviso_superior" /></label>
                    <label class="grupo-campo"><span>WhatsApp internacional</span><input class="campo" name="whatsapp" inputmode="numeric" required /></label>
                    <label class="grupo-campo"><span>Correo comercial</span><input class="campo" name="correo" type="email" required /></label>
                    <label class="grupo-campo"><span>Instagram</span><input class="campo" name="instagram" type="url" /></label>
                    <label class="grupo-campo"><span>TikTok</span><input class="campo" name="tiktok" type="url" /></label>
                    <label class="grupo-campo"><span>Región</span><input class="campo" name="region" /></label>
                    <label class="grupo-campo campo-completo"><span>Descripción general</span><textarea class="area-texto" name="descripcion_corta" rows="3"></textarea></label>
                    <label class="grupo-campo campo-completo"><span>Texto descriptivo del footer</span><textarea class="area-texto" name="descripcion_footer" rows="3"></textarea></label>
                    <label class="grupo-campo"><span>Título de enlaces del footer</span><input class="campo" name="titulo_footer_explorar" /></label>
                    <label class="grupo-campo"><span>Título de contacto del footer</span><input class="campo" name="titulo_footer_contacto" /></label>
                    <div class="acciones-formulario campo-completo">
                      <button class="boton boton-principal" type="submit">Guardar contenido general</button>
                    </div>
                  </form>
                </section>

                <details class="tarjeta-contenido-global opciones-contenido-global">
                  <summary>Paleta y tipografía general</summary>
                  <p>Estos colores se usan en todo el sitio. Para invertir la paleta, intercambiá el color inicial y el final.</p>
                  <form id="formulario-estilos-globales" class="formulario-dos-columnas">
                    <label class="grupo-campo selector-color"><span>Color inicial de la marca</span><input name="color_principal" type="color" value="#98b7ff" /></label>
                    <label class="grupo-campo selector-color"><span>Color final de la marca</span><input name="color_secundario" type="color" value="#df98ff" /></label>
                    <label class="grupo-campo selector-color"><span>Color inicial intenso</span><input name="color_principal_intenso" type="color" value="#526ca8" /></label>
                    <label class="grupo-campo selector-color"><span>Color final intenso</span><input name="color_secundario_intenso" type="color" value="#9358ad" /></label>
                    <label class="grupo-campo selector-color"><span>Fondo del sitio</span><input name="color_fondo" type="color" value="#fbfaff" /></label>
                    <label class="grupo-campo selector-color"><span>Texto principal</span><input name="color_texto" type="color" value="#252434" /></label>
                    <label class="grupo-campo selector-color"><span>Texto secundario</span><input name="color_texto_suave" type="color" value="#676579" /></label>
                    <label class="grupo-campo"><span>Tipografía general</span><select class="selector" name="fuente_principal"><option value="moderna">Moderna</option><option value="redondeada">Redondeada</option><option value="clasica">Clásica</option></select></label>
                    <div class="acciones-formulario campo-completo">
                      <button class="boton boton-principal" type="submit">Guardar paleta y tipografía</button>
                    </div>
                  </form>
                </details>
              </div>
            )}
          </section>
        ))}

      </main>
    </div>
  </div>

  <dialog id="dialogo-recurso" class="dialogo-recurso">
    <form id="formulario-recurso" class="formulario-dialogo" method="dialog">
      <div class="cabecera-dialogo">
        <div>
          <p class="etiqueta">Contenido administrable</p>
          <h2 id="titulo-dialogo">Nuevo registro</h2>
        </div>
        <button id="cerrar-dialogo" class="boton-icono" type="button" aria-label="Cerrar">×</button>
      </div>
      <div id="campos-formulario-recurso" class="formulario-admin formulario-dos-columnas"></div>
      <p id="error-formulario-recurso" class="mensaje-error" role="alert" hidden></p>
      <div class="acciones-dialogo">
        <button id="cancelar-dialogo" class="boton boton-secundario" type="button">Cancelar</button>
        <button class="boton boton-principal" type="submit">Guardar</button>
      </div>
    </form>
  </dialog>

  <script>
    import '../../scripts/administracion.js';
  </script>
</DisenoPrincipal>
