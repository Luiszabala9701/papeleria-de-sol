---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import type { ConfiguracionSitio, Producto } from '../../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerProductoPorSlug,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

export const prerender = false;

const { slug } = Astro.params;
const [configuracion, producto] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductoPorSlug(slug),
]) as [ConfiguracionSitio, Producto | null];

if (!producto) {
  return Astro.redirect('/404');
}

const imagen = producto.imagenes?.find((elemento) => elemento.es_principal) || producto.imagenes?.[0];
const esSticker = producto.tipo_producto === 'sticker';
const precio = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: producto.moneda || 'ARS',
  maximumFractionDigits: 0,
}).format(producto.precio);
const tituloSeo = producto.meta_titulo?.trim() || `${producto.nombre} | Papelería de Sol`;
const descripcionSeo = producto.meta_descripcion?.trim() || `${producto.descripcion} Consultá disponibilidad por WhatsApp en CABA y GBA.`;
const urlProducto = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

const datosCarrito = JSON.stringify({
  id: producto.id,
  nombre: producto.nombre,
  slug: producto.slug,
  tipo_producto: producto.tipo_producto,
  precio: producto.precio,
  moneda: producto.moneda,
  imagen: imagen?.url_publica || '/stickers/1.webp',
});

const datosEstructurados = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: producto.nombre,
  description: producto.descripcion,
  image: imagen?.url_publica,
  sku: producto.sku,
  category: producto.categoria?.nombre || producto.tipo_producto,
  url: urlProducto,
  brand: { '@type': 'Brand', name: 'Papelería de Sol' },
}).replace(/</g, '\\u003c');
---

<DisenoPrincipal
  titulo={tituloSeo}
  descripcion={descripcionSeo}
  configuracion={configuracion}
  imagenSocial={imagen?.url_publica}
  imagenSocialAlt={imagen?.texto_alternativo || producto.nombre}
>
  <Fragment slot="cabecera">
    <script is:inline type="application/ld+json" set:html={datosEstructurados}></script>
  </Fragment>

  <article class="contenedor detalle-producto">
    <div class="galeria-detalle" data-proteccion-imagen={esSticker ? 'sticker' : undefined}>
      <img
        src={imagen?.url_publica || '/stickers/1.webp'}
        alt={imagen?.texto_alternativo || producto.nombre}
        width="709"
        height="709"
        draggable={esSticker ? 'false' : undefined}
      />
    </div>

    <div class="informacion-detalle">
      <p class="etiqueta">{producto.tipo_producto === 'fisico' ? obtenerTextoPublico(configuracion, 'producto_tipo_fisico') : producto.tipo_producto}</p>
      <h1>{producto.nombre}</h1>
      <p class="precio-detalle"><strong>{precio}</strong></p>
      <p class="descripcion-detalle">{producto.descripcion}</p>

      <ul class="lista-detalle">
        {producto.sku && <li><strong>{obtenerTextoPublico(configuracion, 'producto_sku')}:</strong> {producto.sku}</li>}
        {producto.categoria?.nombre && <li><strong>{obtenerTextoPublico(configuracion, 'producto_categoria')}:</strong> {producto.categoria.nombre}</li>}
        {producto.controla_stock && <li><strong>{obtenerTextoPublico(configuracion, 'producto_disponibilidad')}:</strong> {Number(producto.stock) > 0 ? obtenerTextoPublico(configuracion, 'producto_en_stock') : obtenerTextoPublico(configuracion, 'producto_consultar')}</li>}
      </ul>

      <p class="aviso-whatsapp">{obtenerTextoPublico(configuracion, 'producto_aviso_whatsapp')}</p>
      <button
        class="boton boton-principal boton-ancho"
        type="button"
        data-agregar-producto
        data-producto={datosCarrito}
      >
        {obtenerTextoPublico(configuracion, 'producto_agregar_seleccion')}
      </button>
    </div>
  </article>
</DisenoPrincipal>
