---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import GaleriaProducto from '../../componentes/GaleriaProducto.astro';
import type { ConfiguracionSitio, Producto } from '../../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerProductoPorSlug,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';
import {
  crearDescripcionProductoSeo,
  crearUrlAbsoluta,
  escaparJsonLd,
} from '../../servicios/seo';
import { crearLineaSeleccion, necesitaElegirVariante, productoSinStock } from '../../servicios/variantes.js';

export const prerender = false;

const { slug } = Astro.params;
const [configuracion, producto] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductoPorSlug(slug),
]) as [ConfiguracionSitio, Producto | null];

if (!producto) {
  return Astro.redirect('/404');
}

const imagen = producto.imagenes?.find((elemento) => elemento.es_principal) || producto.imagenes?.[0];
const esSticker = producto.tipo_producto === 'sticker';
const precio = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: producto.moneda || 'ARS',
  minimumFractionDigits: 0, maximumFractionDigits: 2,
}).format(producto.precio);
const tituloSeo = producto.meta_titulo?.trim() || `${producto.nombre} | Papelería de Sol`;
const descripcionSeo = crearDescripcionProductoSeo(producto);
const urlProducto = crearUrlAbsoluta(Astro.url.pathname);
const stockDisponible = producto.controla_stock
  ? Math.max(0, Math.floor(Number(producto.stock) || 0))
  : 0;
const sinStock = productoSinStock(producto);
const elegir = necesitaElegirVariante(producto);
const varianteInicial = producto.usa_variantes && producto.variantes?.length === 1 ? producto.variantes[0] : null;
const imagenesIniciales = varianteInicial?.imagenes?.length ? varianteInicial.imagenes : producto.imagenes;
const coleccion = {
  sticker: { nombre: 'Stickers', ruta: '/stickers' },
  plantilla: { nombre: 'Plantillas', ruta: '/plantillas' },
  fisico: { nombre: 'Productos físicos', ruta: '/productos-fisicos' },
}[producto.tipo_producto];
const imagenesEstructuradas = producto.imagenes?.length
  ? producto.imagenes.map((elemento) => crearUrlAbsoluta(elemento.url_publica))
  : [crearUrlAbsoluta('/stickers/1.webp')];
const disponibilidadEstructurada = sinStock
  ? 'https://schema.org/OutOfStock'
  : 'https://schema.org/InStock';

const datosCarrito = JSON.stringify(crearLineaSeleccion(producto));

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: producto.nombre,
      description: descripcionSeo,
      image: imagenesEstructuradas,
      sku: producto.sku,
      category: producto.categoria?.nombre || coleccion.nombre,
      url: urlProducto,
      brand: { '@type': 'Brand', name: 'Papelería de Sol' },
      offers: producto.usa_variantes ? producto.variantes?.map(variante => ({
        '@type': 'Offer', name: variante.nombre, sku: variante.sku,
        url: urlProducto, price: variante.precio, priceCurrency: producto.moneda || 'ARS',
        availability: producto.tipo_producto === 'fisico' && !variante.stock ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
      })) : {
        '@type': 'Offer',
        url: urlProducto,
        priceCurrency: producto.moneda || 'ARS',
        price: Number(producto.precio),
        availability: disponibilidadEstructurada,
        itemCondition: 'https://schema.org/NewCondition',
        seller: { '@type': 'Organization', '@id': `${crearUrlAbsoluta('/')}#organizacion`, name: 'Papelería de Sol', url: crearUrlAbsoluta('/') },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: crearUrlAbsoluta('/'),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: coleccion.nombre,
          item: crearUrlAbsoluta(coleccion.ruta),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: producto.nombre,
          item: urlProducto,
        },
      ],
    },
  ],
};
---

<DisenoPrincipal
  titulo={tituloSeo}
  descripcion={descripcionSeo}
  configuracion={configuracion}
  imagenSocial={imagen?.url_publica}
  imagenSocialAlt={imagen?.texto_alternativo || producto.nombre}
  palabrasClave={`${producto.nombre}, ${coleccion.nombre.toLocaleLowerCase('es-AR')}, papelería creativa, CABA, GBA, comprar por WhatsApp`}
>
  <Fragment slot="cabecera">
    <script is:inline type="application/ld+json" set:html={escaparJsonLd(datosEstructurados)}></script>
  </Fragment>

  <article class="contenedor detalle-producto" data-detalle-variantes data-producto-venta={JSON.stringify(producto)}>
    <GaleriaProducto imagenes={imagenesIniciales} nombreProducto={producto.nombre} proteger={esSticker} compacta={esSticker} />

    <div class="informacion-detalle">
      <p class="etiqueta">{producto.tipo_producto === 'fisico' ? obtenerTextoPublico(configuracion, 'producto_tipo_fisico') : producto.tipo_producto}</p>
      <h1>{producto.nombre}</h1>
      <p class="precio-detalle" aria-live="polite"><strong data-precio-variante>{elegir ? 'Desde ' : ''}{precio}</strong></p>
      <p class="descripcion-detalle">{producto.descripcion}</p>
      {producto.usa_variantes && <label class="grupo-campo selector-version">
        <span>{esSticker ? 'Versión del sticker' : 'Variante del producto'}</span>
        <select class="selector" data-elegir-variante aria-label={esSticker ? 'Versión del sticker' : 'Variante del producto'}>
          {elegir && <option value="">Elegí una opción</option>}
          {producto.variantes?.map(variante => <option value={variante.id} selected={variante.id === varianteInicial?.id} disabled={producto.tipo_producto === 'fisico' && !variante.stock}>
            {variante.nombre}{producto.tipo_producto === 'fisico' && !variante.stock ? ' — Sin stock' : ''}
          </option>)}
        </select>
      </label>}
      <p class="descripcion-detalle" data-descripcion-variante hidden={!varianteInicial?.descripcion}>{varianteInicial?.descripcion}</p>

      <ul class="lista-detalle">
        {producto.sku && <li><strong>{obtenerTextoPublico(configuracion, 'producto_sku')}:</strong> <span data-sku-variante>{producto.sku || varianteInicial?.sku}</span></li>}
        {producto.categoria?.nombre && <li><strong>{obtenerTextoPublico(configuracion, 'producto_categoria')}:</strong> {producto.categoria.nombre}</li>}
        {producto.controla_stock && <li><strong>{obtenerTextoPublico(configuracion, 'producto_disponibilidad')}:</strong> <span data-stock-variante>{elegir ? 'Elegí una variante' : sinStock ? 'Sin stock' : 'En stock'}</span></li>}
      </ul>

      <div
        class="selector-cantidad-producto"
        data-selector-cantidad
        data-controla-stock={producto.controla_stock ? 'true' : 'false'}
        data-maximo={producto.controla_stock ? stockDisponible : undefined}
        data-pendiente-variante={elegir ? 'true' : 'false'}
      >
        <span class="etiqueta-cantidad-producto">Cantidad</span>
        <div class="controles-cantidad" aria-label={`Cantidad de ${producto.nombre}`}>
          <button type="button" data-selector-cantidad-restar aria-label="Reducir cantidad" disabled>−</button>
          <output data-selector-cantidad-valor aria-live="polite">1</output>
          <button type="button" data-selector-cantidad-sumar aria-label="Aumentar cantidad" disabled={sinStock || elegir}>+</button>
        </div>
        {producto.controla_stock && (
          <small class="disponibilidad-cantidad-producto" data-unidades-variante>
            {elegir ? 'El stock corresponde a la variante elegida.' : sinStock ? 'Sin unidades disponibles por ahora.' : `${stockDisponible} ${stockDisponible === 1 ? 'unidad disponible' : 'unidades disponibles'}.`}
          </small>
        )}
      </div>
      <button
        class="boton boton-principal boton-ancho"
        type="button"
        data-agregar-producto
        data-producto={datosCarrito}
        data-cantidad="1"
        disabled={sinStock || elegir}
        data-texto-agregar={obtenerTextoPublico(configuracion, 'producto_agregar_seleccion')}
      >
        {elegir ? 'Elegí una versión' : sinStock ? 'Sin stock' : obtenerTextoPublico(configuracion, 'producto_agregar_seleccion')}
      </button>
    </div>
  </article>
  <nav class="contenedor enlaces-producto" aria-label="Seguir explorando">
    <a href={coleccion.ruta}>Ver más {coleccion.nombre.toLocaleLowerCase('es-AR')} de Papelería de Sol</a>
    <a href="/ayuda">Cómo comprar por WhatsApp</a>
  </nav>
  <script>
    import '../../scripts/galeria-producto.js';
    import '../../scripts/cantidad-producto.js';
    import '../../scripts/variantes-producto.js';
  </script>
</DisenoPrincipal>

<style>
  .enlaces-producto { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; padding-bottom: 2rem; }
  .enlaces-producto a { color: var(--azul-profundo); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
