---
import DisenoPrincipal from '../disenos/DisenoPrincipal.astro';
import { obtenerConfiguracionSitio } from '../servicios/repositorio-contenidos.js';
const configuracion = await obtenerConfiguracionSitio();
Astro.response.status = 404;
---

<DisenoPrincipal
  titulo="Página no encontrada | Papelería de Sol"
  descripcion="La página que buscás no está disponible."
  configuracion={configuracion}
  ocultarNavegacion
  noIndexar
>
  <section class="contenedor pagina-error">
    <p class="etiqueta">Error 404</p>
    <h1>Esta página se fue a tomar un poco de Sol</h1>
    <p>No encontramos la dirección que buscabas, pero los stickers siguen esperándote.</p>
    <a class="boton boton-principal" href="/catalogo">Ver stickers</a>
  </section>
</DisenoPrincipal>

<style>
  .pagina-error {
    display: grid;
    min-height: 62vh;
    place-items: center;
    align-content: center;
    text-align: center;
  }

  .pagina-error h1 {
    max-width: 760px;
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .pagina-error p:not(.etiqueta) {
    color: var(--tinta-suave);
  }
</style>
