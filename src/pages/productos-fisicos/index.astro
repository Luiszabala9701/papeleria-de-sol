---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import ListadoProductosFiltrable from '../../componentes/ListadoProductosFiltrable.astro';
import GuiaColeccion from '../../componentes/GuiaColeccion.astro';
import { crearUrlCatalogo, tituloPaginaCatalogo } from '../../servicios/catalogo.js';
import type { ConfiguracionSitio } from '../../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerCategoriasPublicadas,
  obtenerPaginaProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

const [configuracion, paginaCatalogo, categorias] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerPaginaProductosPublicados({ tipo: 'fisico', parametros: Astro.url.searchParams }),
  obtenerCategoriasPublicadas(),
]) as [ConfiguracionSitio, Awaited<ReturnType<typeof obtenerPaginaProductosPublicados>>, { id: string; nombre: string; tipo_producto?: 'fisico' }[]];
---

<DisenoPrincipal
  titulo={tituloPaginaCatalogo('fisico', paginaCatalogo.pagina)}
  descripcion="Llaveros acrílicos, cuadernos A6 y regalos de Papelería de Sol. Consultá stock y personalización por WhatsApp. Retiro o envío a coordinar en CABA y GBA."
  rutaCanonica={crearUrlCatalogo(Astro.url.pathname, paginaCatalogo)}
  noIndexar={paginaCatalogo.tieneFiltros}
  configuracion={configuracion}
  imagenSocialAlt="Productos físicos personalizados de Papelería de Sol"
  palabrasClave="llaveros acrílicos, cuadernos A6, regalos personalizados, papelería para regalar, papelería creativa Buenos Aires, CABA, GBA, Papelería de Sol"
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'fisicos_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'fisicos_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'fisicos_descripcion')}</p>
  </header>

  {paginaCatalogo.totalProductos > 0 || paginaCatalogo.tieneFiltros ? (
    <ListadoProductosFiltrable
      estado={paginaCatalogo}
      categorias={categorias}
      configuracion={configuracion}
      tipo="fisico"
      etiquetaAria="Filtros de productos físicos"
    />
  ) : (
  <section class="contenedor seccion-listado">
      <div class="estado-informativo">
        <div>
          <p class="etiqueta">{obtenerTextoPublico(configuracion, 'fisicos_vacio_etiqueta')}</p>
          <h2>{obtenerTextoPublico(configuracion, 'fisicos_vacio_titulo')}</h2>
          <p>{obtenerTextoPublico(configuracion, 'fisicos_vacio_descripcion')}</p>
          <a class="boton boton-principal" href={`https://wa.me/${configuracion.whatsapp}`} target="_blank" rel="noreferrer">{obtenerTextoPublico(configuracion, 'fisicos_vacio_boton')}</a>
        </div>
      </div>
  </section>
  )}
  {paginaCatalogo.pagina === 1 && !paginaCatalogo.tieneFiltros && <GuiaColeccion tipo="fisico" />}
</DisenoPrincipal>

<style>
  .seccion-listado { padding-bottom: 5rem; }
</style>
