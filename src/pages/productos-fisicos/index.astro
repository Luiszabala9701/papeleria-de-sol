---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import TarjetaProducto from '../../componentes/TarjetaProducto.astro';
import type { ConfiguracionSitio, Producto } from '../../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

const [configuracion, productos] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductosPublicados({ tipo: 'fisico' }),
]) as [ConfiguracionSitio, Producto[]];
---

<DisenoPrincipal
  titulo="Papelería y regalos personalizados en CABA y GBA | Papelería de Sol"
  descripcion="Conocé productos de papelería creativa y regalos personalizados. Consultá disponibilidad, retiro o envío por WhatsApp en CABA y GBA."
  configuracion={configuracion}
  imagenSocialAlt="Productos físicos personalizados de Papelería de Sol"
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'fisicos_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'fisicos_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'fisicos_descripcion')}</p>
  </header>

  <section class="contenedor seccion-listado">
    {productos.length > 0 ? (
      <div class="cuadricula-productos">
        {productos.map((producto) => <TarjetaProducto producto={producto} configuracion={configuracion} />)}
      </div>
    ) : (
      <div class="estado-informativo">
        <div>
          <p class="etiqueta">{obtenerTextoPublico(configuracion, 'fisicos_vacio_etiqueta')}</p>
          <h2>{obtenerTextoPublico(configuracion, 'fisicos_vacio_titulo')}</h2>
          <p>{obtenerTextoPublico(configuracion, 'fisicos_vacio_descripcion')}</p>
          <a class="boton boton-principal" href={`https://wa.me/${configuracion.whatsapp}`} target="_blank" rel="noreferrer">{obtenerTextoPublico(configuracion, 'fisicos_vacio_boton')}</a>
        </div>
      </div>
    )}
  </section>
</DisenoPrincipal>

<style>
  .seccion-listado { padding-bottom: 5rem; }
</style>
