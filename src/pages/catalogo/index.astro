---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import TarjetaProducto from '../../componentes/TarjetaProducto.astro';
import type { ConfiguracionSitio, Producto } from '../../tipos/contenidos';
import {
  obtenerCategoriasPublicadas,
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';
import rutaScriptCatalogo from '../../scripts/catalogo.js?url&no-inline';

const [configuracion, productos, categorias] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductosPublicados({ tipo: 'sticker' }),
  obtenerCategoriasPublicadas(),
]) as [ConfiguracionSitio, Producto[], { id: string; nombre: string; tipo_producto?: string }[]];

const categoriasStickers = categorias.filter((categoria) => categoria.tipo_producto === 'sticker');

const productosIniciales = productos.slice(0, 48);
const datosSeguros = JSON.stringify(productos).replace(/</g, '\\u003c');
---

<DisenoPrincipal
  titulo="Catálogo de stickers y papelería creativa | Papelería de Sol"
  descripcion="Explorá stickers de Papelería de Sol. Armá tu selección y continuá tu compra por WhatsApp desde CABA y GBA."
  configuracion={configuracion}
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'catalogo_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'catalogo_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'catalogo_descripcion')}</p>
  </header>

  <section id="catalogo-resultados" class="contenedor seccion-catalogo">
    <div class="barra-catalogo" aria-label="Filtros del catálogo">
      <form id="formulario-busqueda-catalogo" class="busqueda-catalogo" role="search">
        <label class="solo-lectores" for="buscador-catalogo">Buscar productos</label>
        <input id="buscador-catalogo" class="campo" type="search" placeholder={obtenerTextoPublico(configuracion, 'catalogo_busqueda_placeholder')} autocomplete="off" />
        <button class="boton-busqueda-catalogo" type="submit" aria-label="Buscar stickers">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="6"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <span class="solo-lectores">Buscar</span>
        </button>
      </form>
      <label>
        <span class="solo-lectores">Categoría de stickers</span>
        <select id="filtro-categoria" class="selector">
          <option value="">{obtenerTextoPublico(configuracion, 'catalogo_todas_categorias')}</option>
          {categoriasStickers.map((categoria) => <option value={categoria.id}>{categoria.nombre}</option>)}
        </select>
      </label>
    </div>

    <div class="resultado-catalogo">
      <span id="informacion-resultados">{productos.length} productos</span>
      <span>{obtenerTextoPublico(configuracion, 'catalogo_aviso_disponibilidad')}</span>
    </div>

    <div id="galeria-catalogo" class="cuadricula-productos">
      {productosIniciales.map((producto) => <TarjetaProducto producto={producto} configuracion={configuracion} />)}
    </div>

    <nav class="paginacion" aria-label="Paginación del catálogo">
      <button id="pagina-anterior" class="boton-paginacion" type="button" disabled>{obtenerTextoPublico(configuracion, 'catalogo_pagina_anterior')}</button>
      <span id="informacion-pagina-catalogo">Página 1</span>
      <button id="pagina-siguiente" class="boton-paginacion" type="button">{obtenerTextoPublico(configuracion, 'catalogo_pagina_siguiente')}</button>
    </nav>
  </section>

  <script is:inline id="datos-catalogo" type="application/json" set:html={datosSeguros}></script>
  <script is:inline src={rutaScriptCatalogo}></script>
</DisenoPrincipal>

<style>
  .seccion-catalogo {
    padding-bottom: 5rem;
  }
</style>
