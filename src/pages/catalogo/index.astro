---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import ListadoProductosFiltrable from '../../componentes/ListadoProductosFiltrable.astro';
import type { ConfiguracionSitio, Producto } from '../../tipos/contenidos';
import {
  obtenerCategoriasPublicadas,
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

const [configuracion, productos, categorias] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductosPublicados({ tipo: 'sticker' }),
  obtenerCategoriasPublicadas(),
]) as [ConfiguracionSitio, Producto[], { id: string; nombre: string; tipo_producto?: string }[]];

---

<DisenoPrincipal
  titulo="Stickers en CABA y GBA | Papelería de Sol"
  descripcion="Encontrá stickers para cuadernos, agendas, notebook y más. Consultá precios y disponibilidad por WhatsApp en CABA y GBA."
  configuracion={configuracion}
  imagenSocialAlt="Stickers de Papelería de Sol"
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'catalogo_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'catalogo_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'catalogo_descripcion')}</p>
  </header>

  <ListadoProductosFiltrable
    productos={productos}
    categorias={categorias}
    configuracion={configuracion}
    tipo="sticker"
    etiquetaAria="Filtros de stickers"
  />
</DisenoPrincipal>
