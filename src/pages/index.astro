---
import DisenoPrincipal from '../disenos/DisenoPrincipal.astro';
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import type { ConfiguracionSitio, Producto, SeccionSitio } from '../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
  obtenerSeccionesPublicadas,
} from '../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../servicios/textos-publicos';
import { crearUrlAbsoluta, escaparJsonLd } from '../servicios/seo';

const [configuracion, secciones, productos] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerSeccionesPublicadas(),
  obtenerProductosPublicados({ tipo: 'sticker' }),
]) as [ConfiguracionSitio, SeccionSitio[], Producto[]];

const principal: SeccionSitio = secciones.find((seccion) => seccion.clave === 'inicio_principal') || {
  clave: 'inicio_principal',
  titulo: 'Ideas que alegran tus días',
  subtitulo: 'Papelería creativa hecha con dedicación',
  contenido: 'Descubrí stickers, plantillas y productos físicos para regalar, organizar y personalizar. Elegí tus favoritos y consultanos directamente por WhatsApp.',
  texto_boton: 'Explorar stickers',
  enlace_boton: '/stickers',
  publicada: true,
  orden: 1,
};
const seccionDestacados: SeccionSitio = secciones.find((seccion) => seccion.clave === 'inicio_destacados') || {
  clave: 'inicio_destacados',
  titulo: 'Productos destacados',
  subtitulo: 'Nuestros favoritos',
  contenido: 'Una selección de productos de Papelería de Sol.',
  publicada: true,
  orden: 2,
};
const destacados = productos.filter((producto) => producto.destacado).slice(0, 8);
const urlInicio = crearUrlAbsoluta('/');
const logo = crearUrlAbsoluta('/marca/logo-papeleria-de-sol-transparente.png');
const descripcionSeo = 'Papelería creativa en CABA y GBA: stickers para cuadernos, agendas y notebook, regalos personalizados y pedidos por WhatsApp.';
const redesSociales = [configuracion.instagram, configuracion.tiktok]
  .filter((enlace): enlace is string => typeof enlace === 'string' && Boolean(enlace));

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${urlInicio}#organizacion`,
      name: 'Papelería de Sol',
      description: descripcionSeo,
      url: urlInicio,
      logo,
      image: crearUrlAbsoluta('/stickers/1.webp'),
      email: configuracion.correo,
      telephone: configuracion.whatsapp ? `+${configuracion.whatsapp}` : undefined,
      currenciesAccepted: 'ARS',
      areaServed: [
        { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
        { '@type': 'AdministrativeArea', name: 'Gran Buenos Aires' },
      ],
      sameAs: redesSociales,
    },
    {
      '@type': 'WebSite',
      '@id': `${urlInicio}#sitio-web`,
      name: 'Papelería de Sol',
      url: urlInicio,
      inLanguage: 'es-AR',
      publisher: { '@id': `${urlInicio}#organizacion` },
    },
  ],
};
---

<DisenoPrincipal
  titulo="Papelería creativa y stickers en CABA | Papelería de Sol"
  descripcion={descripcionSeo}
  configuracion={configuracion}
  imagenSocialAlt="Stickers y papelería creativa de Papelería de Sol"
  palabrasClave="papelería creativa CABA, papelería online GBA, stickers para cuadernos, stickers para agendas, regalos personalizados, pedidos por WhatsApp"
>
  <Fragment slot="cabecera">
    <script is:inline type="application/ld+json" set:html={escaparJsonLd(datosEstructurados)}></script>
  </Fragment>

  <section class="contenedor hero">
    <div>
      <p class="etiqueta">
        {principal.subtitulo || 'Papelería creativa en CABA y GBA'}
      </p>
      <h1>
        {principal.titulo || 'Ideas que alegran tus días'}
        <span class="texto-degradado"> {obtenerTextoPublico(configuracion, 'inicio_texto_destacado')}</span>
      </h1>
      <p class="hero-descripcion">
        {principal.contenido || configuracion.descripcion_corta}
      </p>
      <div class="grupo-botones">
        <a class="boton boton-principal" href={principal.enlace_boton || '/stickers'}>
          {principal.texto_boton || 'Explorar stickers'}
        </a>
      </div>
    </div>

    <div class="hero-collage" aria-label="Selección de stickers de Papelería de Sol">
      {[1, 2, 3].map((numero) => (
        <div class="hero-imagen" data-proteccion-imagen="sticker" data-sin-marca-agua>
          <img src={`/stickers/${numero}.webp`} alt={`Sticker creativo ${numero}`} width="709" height="709" draggable="false" />
        </div>
      ))}
    </div>

  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <div>
          <p class="etiqueta">
            {seccionDestacados.subtitulo || 'Nuestros favoritos'}
          </p>
          <h2>
            {seccionDestacados.titulo || 'Productos destacados'}
          </h2>
          <p>
            {seccionDestacados.contenido || 'Una selección de productos de Papelería de Sol.'}
          </p>
        </div>
      </header>

      <div class="cuadricula-productos">
        {destacados.map((producto) => <TarjetaProducto producto={producto} configuracion={configuracion} compacta />)}
      </div>
    </div>

  </section>
</DisenoPrincipal>
