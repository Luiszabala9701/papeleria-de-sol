---
import DisenoPrincipal from '../disenos/DisenoPrincipal.astro';
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import type { ConfiguracionSitio, Producto, SeccionSitio } from '../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
  obtenerSeccionesPublicadas,
} from '../servicios/repositorio-contenidos.js';
import { obtenerEstiloTexto } from '../servicios/estilos-visuales';
import { obtenerTextoPublico } from '../servicios/textos-publicos';

const [configuracion, secciones, productos] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerSeccionesPublicadas(),
  obtenerProductosPublicados({ tipo: 'sticker' }),
]) as [ConfiguracionSitio, SeccionSitio[], Producto[]];

const principal = secciones.find((seccion) => seccion.clave === 'inicio_principal');
const seccionDestacados = secciones.find((seccion) => seccion.clave === 'inicio_destacados');
const destacados = productos.filter((producto) => producto.destacado).slice(0, 8);
const escaparJson = (valor: unknown) => JSON.stringify(valor).replace(/</g, '\\u003c');

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: configuracion.nombre_marca,
  description: configuracion.descripcion_corta,
  email: configuracion.correo,
  telephone: `+${configuracion.whatsapp}`,
  areaServed: ['Ciudad Autónoma de Buenos Aires', 'Gran Buenos Aires'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ciudad Autónoma de Buenos Aires',
    addressCountry: 'AR',
  },
  sameAs: [configuracion.instagram, configuracion.tiktok].filter(Boolean),
};
---

<DisenoPrincipal
  titulo="Papelería de Sol | Stickers y papelería creativa en CABA y GBA"
  descripcion={configuracion.descripcion_corta}
  configuracion={configuracion}
>
  <Fragment slot="cabecera">
    <script is:inline type="application/ld+json" set:html={escaparJson(datosEstructurados)}></script>
  </Fragment>

  <section class="contenedor hero hero-sin-muestras">
    <div>
      <p class="etiqueta" style={obtenerEstiloTexto(principal, 'subtitulo')}>
        {principal?.subtitulo || 'Papelería creativa en CABA y GBA'}
      </p>
      <h1 style={obtenerEstiloTexto(principal, 'titulo')}>
        {principal?.titulo || 'Ideas que alegran tus días'}
        <span class="texto-degradado"> {obtenerTextoPublico(configuracion, 'inicio_texto_destacado')}</span>
      </h1>
      <p class="hero-descripcion" style={obtenerEstiloTexto(principal, 'contenido')}>
        {principal?.contenido || configuracion.descripcion_corta}
      </p>
      <div class="grupo-botones">
        <a class="boton boton-principal" href={principal?.enlace_boton || '/catalogo'} style={obtenerEstiloTexto(principal, 'texto_boton')}>
          {principal?.texto_boton || 'Explorar el catálogo'}
        </a>
      </div>
    </div>

  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <div>
          <p class="etiqueta" style={obtenerEstiloTexto(seccionDestacados, 'subtitulo')}>
            {seccionDestacados?.subtitulo || 'Nuestros favoritos'}
          </p>
          <h2 style={obtenerEstiloTexto(seccionDestacados, 'titulo')}>
            {seccionDestacados?.titulo || 'Stickers destacados'}
          </h2>
          <p style={obtenerEstiloTexto(seccionDestacados, 'contenido')}>
            {seccionDestacados?.contenido || 'Una pequeña muestra de la colección. En el catálogo podés buscar y combinar los diseños que quieras.'}
          </p>
        </div>
        <a class="enlace-texto" href={seccionDestacados?.enlace_boton || '/catalogo?tipo=sticker'} style={obtenerEstiloTexto(seccionDestacados, 'texto_boton')}>
          {seccionDestacados?.texto_boton || 'Ver los 1.000 stickers'}
        </a>
      </header>

      <div class="cuadricula-productos">
        {destacados.map((producto) => <TarjetaProducto producto={producto} configuracion={configuracion} compacta />)}
      </div>
    </div>
  </section>
</DisenoPrincipal>
