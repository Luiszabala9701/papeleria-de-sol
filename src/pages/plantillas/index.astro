---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import ListadoProductosFiltrable from '../../componentes/ListadoProductosFiltrable.astro';
import GuiaColeccion from '../../componentes/GuiaColeccion.astro';
import { crearUrlCatalogo, tituloPaginaCatalogo } from '../../servicios/catalogo.js';
import type { ConfiguracionSitio } from '../../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerCategoriasPublicadas,
  obtenerPaginaProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

const [configuracion, paginaCatalogo, categorias] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerPaginaProductosPublicados({ tipo: 'plantilla', parametros: Astro.url.searchParams }),
  obtenerCategoriasPublicadas(),
]) as [ConfiguracionSitio, Awaited<ReturnType<typeof obtenerPaginaProductosPublicados>>, { id: string; nombre: string; tipo_producto?: 'plantilla' }[]];
---

<DisenoPrincipal
  titulo={tituloPaginaCatalogo('plantilla', paginaCatalogo.pagina)}
  descripcion="Plantillas creativas de Papelería de Sol para organizar, estudiar y crear. Consultá diseños disponibles, formatos y personalización por WhatsApp."
  rutaCanonica={crearUrlCatalogo(Astro.url.pathname, paginaCatalogo)}
  noIndexar={paginaCatalogo.tieneFiltros}
  configuracion={configuracion}
  imagenSocialAlt="Plantillas digitales de Papelería de Sol"
  palabrasClave="plantillas creativas, plantillas para organizar, diseños personalizados, plantillas para estudiar, Papelería de Sol"
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'plantillas_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'plantillas_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'plantillas_descripcion')}</p>
  </header>

  {paginaCatalogo.totalProductos > 0 || paginaCatalogo.tieneFiltros ? (
    <ListadoProductosFiltrable
      estado={paginaCatalogo}
      categorias={categorias}
      configuracion={configuracion}
      tipo="plantilla"
      etiquetaAria="Filtros de plantillas"
    />
  ) : (
  <section class="contenedor seccion-listado">
      <div class="estado-informativo">
        <div>
          <p class="etiqueta">{obtenerTextoPublico(configuracion, 'plantillas_vacio_etiqueta')}</p>
          <h2>{obtenerTextoPublico(configuracion, 'plantillas_vacio_titulo')}</h2>
          <p>{obtenerTextoPublico(configuracion, 'plantillas_vacio_descripcion')}</p>
          <a class="boton boton-principal" href={`https://wa.me/${configuracion.whatsapp}`} target="_blank" rel="noreferrer">{obtenerTextoPublico(configuracion, 'plantillas_vacio_boton')}</a>
        </div>
      </div>
  </section>
  )}
  {paginaCatalogo.pagina === 1 && !paginaCatalogo.tieneFiltros && <GuiaColeccion tipo="plantilla" />}
</DisenoPrincipal>

<style>
  .seccion-listado { padding-bottom: 5rem; }
</style>
