---
import DisenoPrincipal from '../../disenos/DisenoPrincipal.astro';
import TarjetaProducto from '../../componentes/TarjetaProducto.astro';
import type { ConfiguracionSitio, Producto } from '../../tipos/contenidos';
import {
  obtenerConfiguracionSitio,
  obtenerProductosPublicados,
} from '../../servicios/repositorio-contenidos.js';
import { obtenerTextoPublico } from '../../servicios/textos-publicos';

const [configuracion, plantillas] = await Promise.all([
  obtenerConfiguracionSitio(),
  obtenerProductosPublicados({ tipo: 'plantilla' }),
]) as [ConfiguracionSitio, Producto[]];
---

<DisenoPrincipal
  titulo="Plantillas creativas | Papelería de Sol"
  descripcion="Plantillas creativas editables e imprimibles de Papelería de Sol para CABA, GBA y toda Argentina."
  configuracion={configuracion}
>
  <header class="contenedor cabecera-pagina">
    <p class="etiqueta">{obtenerTextoPublico(configuracion, 'plantillas_etiqueta')}</p>
    <h1>{obtenerTextoPublico(configuracion, 'plantillas_titulo')}</h1>
    <p>{obtenerTextoPublico(configuracion, 'plantillas_descripcion')}</p>
  </header>

  <section class="contenedor seccion-listado">
    {plantillas.length > 0 ? (
      <div class="cuadricula-productos">
        {plantillas.map((producto) => <TarjetaProducto producto={producto} configuracion={configuracion} />)}
      </div>
    ) : (
      <div class="estado-informativo">
        <div>
          <p class="etiqueta">{obtenerTextoPublico(configuracion, 'plantillas_vacio_etiqueta')}</p>
          <h2>{obtenerTextoPublico(configuracion, 'plantillas_vacio_titulo')}</h2>
          <p>{obtenerTextoPublico(configuracion, 'plantillas_vacio_descripcion')}</p>
          <a class="boton boton-principal" href={`https://wa.me/${configuracion.whatsapp}`} target="_blank" rel="noreferrer">{obtenerTextoPublico(configuracion, 'plantillas_vacio_boton')}</a>
        </div>
      </div>
    )}
  </section>
</DisenoPrincipal>

<style>
  .seccion-listado { padding-bottom: 5rem; }
</style>
