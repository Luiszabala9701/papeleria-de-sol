---
import '../estilos/global.css';
import Encabezado from '../componentes/Encabezado.astro';
import PiePagina from '../componentes/PiePagina.astro';
import Carrito from '../componentes/Carrito.astro';
import BotonWhatsAppFlotante from '../componentes/BotonWhatsAppFlotante.astro';
import AvisoWhatsApp from '../componentes/AvisoWhatsApp.astro';
import ModalesLegales from '../componentes/ModalesLegales.astro';
import { esColorHexadecimal, obtenerEstiloGlobal } from '../servicios/estilos-visuales';

const {
  titulo = 'Papelería de Sol',
  descripcion = 'Papelería creativa, stickers y productos personalizados en CABA y GBA.',
  configuracion,
  imagenSocial = '/stickers/1.webp',
  imagenSocialAlt = titulo,
  ocultarNavegacion = false,
  noIndexar = false,
} = Astro.props;

const rutaActual = Astro.url.pathname;
const urlCanonica = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const imagenAbsoluta = new URL(imagenSocial, Astro.site || Astro.url.origin);
const colorTema = esColorHexadecimal(configuracion?.color_principal)
  ? configuracion.color_principal
  : '#98b7ff';
const estiloGlobal = obtenerEstiloGlobal(configuracion);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const raiz = document.documentElement;

        const actualizarVistaMovil = () => {
          const esTelefono = window.matchMedia('(pointer: coarse)').matches
            && Math.min(window.screen.width, window.screen.height) <= 800;
          const usaViewportDeEscritorio = window.innerWidth > 1024;

          raiz.classList.toggle('vista-movil-forzada', esTelefono && usaViewportDeEscritorio);
        };

        actualizarVistaMovil();
        window.addEventListener('resize', actualizarVistaMovil);
        window.addEventListener('orientationchange', actualizarVistaMovil);
      })();
    </script>
    <meta name="theme-color" content={colorTema} />
    <meta name="description" content={descripcion} />
    {noIndexar ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" href="/marca/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/marca/logo-papeleria-de-sol.png" />

    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Papelería de Sol" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:alt" content={imagenSocialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <meta name="twitter:image:alt" content={imagenSocialAlt} />

    <title>{titulo}</title>
    <slot name="cabecera" />
  </head>
  <body id="inicio-pagina" style={estiloGlobal}>
    <a class="salto-contenido" href="#contenido-principal">Saltar al contenido</a>
    {!ocultarNavegacion && (
      <Encabezado configuracion={configuracion} rutaActual={rutaActual} />
    )}
    <main id="contenido-principal">
      <slot />
    </main>
    {!ocultarNavegacion && <PiePagina configuracion={configuracion} />}
    {!ocultarNavegacion && <Carrito configuracion={configuracion} />}
    {!ocultarNavegacion && <BotonWhatsAppFlotante configuracion={configuracion} />}
    {!ocultarNavegacion && <AvisoWhatsApp />}
    {!ocultarNavegacion && <ModalesLegales />}

    <a id="volver-arriba" class="boton-volver-arriba" href="#inicio-pagina" aria-label="Volver al inicio" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6" /></svg>
    </a>

    <div id="contenedor-notificaciones" class="contenedor-notificaciones" aria-live="polite"></div>

    <script is:inline>
      (() => {
        const boton = document.querySelector('#volver-arriba');
        if (!boton) return;

        const actualizarVisibilidad = () => {
          boton.hidden = window.scrollY < 500;
        };

        window.addEventListener('scroll', actualizarVisibilidad, { passive: true });
        actualizarVisibilidad();
      })();
    </script>

    {!ocultarNavegacion && (
      <script>
        import '../scripts/menu.js';
        import '../scripts/aviso-whatsapp.js';
        import '../scripts/modales-legales.js';
        import '../scripts/carrito.js';
        import '../scripts/proteccion-stickers.js';
      </script>
    )}
  </body>
</html>
