# URL pública que entrega Supabase al crear el proyecto.
PUBLIC_SUPABASE_URL=

# Clave pública o publicable. Nunca colocar aquí una clave secret o service_role.
PUBLIC_SUPABASE_CLAVE_PUBLICA=

# URL canónica del sitio. Cambiarla cuando exista un dominio propio.
PUBLIC_URL_SITIO=https://papeleria-de-sol.netlify.app

# Activa los datos locales de demostración mientras Supabase no esté conectado.
PUBLIC_USAR_DATOS_DEMOSTRACION=true

# Evita que Astro intente guardar telemetría en el perfil del sistema.
ASTRO_TELEMETRY_DISABLED=1
